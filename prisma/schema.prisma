generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Đã xác nhận lại là PostgreSQL
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  BUYER
  SELLER
  ADMIN
}

// --- MODELS ---

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullName  String
  role      Role     @default(BUYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  avatarUrl String?

  // Relations
  shop    Shop?
  orders  Order[]
  reviews Review[]
}

model Shop {
  id          Int     @id @default(autoincrement())
  ownerId     Int     @unique
  name        String
  villageName String?

  avatarUrl   String?
  coverUrl    String?

  description String? // Câu chuyện nghệ nhân
  isVerified  Boolean @default(false)

  // THÊM DÒNG NÀY:
  createdAt   DateTime @default(now())
  
  owner    User      @relation(fields: [ownerId], references: [id])
  orders   Order[]
  products Product[]
  blogs    Blog[]    
}

model Blog {
  id          Int      @id @default(autoincrement())
  shopId      Int
  
  title       String
  slug        String   @unique // Dùng để làm URL thân thiện (vd: /blog/cach-chon-gom-su)
  description String?  // Đoạn giới thiệu ngắn (Sapo)
  content     String   @db.Text // Nội dung Markdown (Text dài)
  coverUrl    String?  // Ảnh bìa
  
  // PostgreSQL hỗ trợ lưu mảng String trực tiếp
  tags        String[] 
  
  readingTime String?
  
  isPublished Boolean  @default(true) // Trạng thái nháp/công khai
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Product {
  id            Int      @id @default(autoincrement())
  shopId        Int
  name          String
  description   String   @db.Text
  
  // RÚT GỌN: Lưu dạng String để đơn giản hóa
  category      String   // VD: "Gốm sứ"
  material      String?  // VD: "Đất nung"
  origin        String?  // VD: "Bát Tràng"

  images        String[]
  
  // POSTGRESQL: Dùng Decimal để tính tiền chính xác
  price         Decimal  @db.Decimal(15, 2) 
  stockQuantity Int      @default(0)
  viewCount     Int      @default(0)
  soldCount     Int      @default(0)
  createdAt     DateTime @default(now())

  shop       Shop        @relation(fields: [shopId], references: [id])
  reviews    Review[]    
  orderItems OrderItem[]
}

enum OrderStatus {
  PENDING     // Chờ xác nhận
  PREPARING   // Người bán đang chuẩn bị hàng
  SHIPPING    // Đang giao hàng
  COMPLETED   // Giao thành công / Đã nhận
  CANCELLED   // Đã hủy
}
model Order {
  id          Int      @id @default(autoincrement())
  
  // Liên kết người mua
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  // --- THÊM MỚI: Liên kết trực tiếp với Shop ---
  shopId      Int
  shop        Shop     @relation(fields: [shopId], references: [id])
  // -------------------------------------------

  totalAmount Decimal  @db.Decimal(15, 2)
  
  // Đổi String -> Enum
  status      OrderStatus @default(PENDING)
  
  address     String
  phone       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal @db.Decimal(15, 2)

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1 đến 5 sao
  comment   String?
  
  userId    Int
  productId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  // Ràng buộc: Một user chỉ được review 1 sản phẩm 1 lần (Unique compound)
  @@unique([userId, productId]) 
}